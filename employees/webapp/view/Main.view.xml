<mvc:View controllerName="logali.employees.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m"
    displayBlock="true">
    <Shell id="shell">
        <App id="app">
            <pages>
                <Page showHeader="false">
                    <content>
                        <f:FlexibleColumnLayout id="fcl" backgroundDesign="Solid" layout="{jsonLayout>/ActiveKey}">
                            <f:beginColumnPages>
                                <mvc:XMLView id="masterEmployeeView" viewName="logali.employees.view.MasterEmployee"/>
                            </f:beginColumnPages>
                            <f:midColumnPages>
                                <mvc:XMLView id="detailEmployeeView" viewName="logali.employees.view.EmployeeDetails"/>
                            </f:midColumnPages>
                            <f:endColumnPages>
                                <Page>
                                </Page>
                            </f:endColumnPages>
                        </f:FlexibleColumnLayout>
                    </content>
                    <Toolbar>
                        <Label text="{i18n>layout}" class="sapUiSmallMargin"/>
                        <Select items="{jsonLayout>/Layout}" selectedKey="{jsonLayout>/ActiveKey}">
                            <core:Item key="{jsonLayout>Key}" text="{jsonLayout>Text}"/>
                        </Select>
                    </Toolbar>
                </Page>
            </pages>
        </App>
    </Shell>
</mvc:View>